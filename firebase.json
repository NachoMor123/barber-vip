{
  "functions": {
    "source": ".",
    "codebase": "default",
    "runtime": "nodejs22",
    "ignore": [
      ".git/**",
      ".firebase/**",
      "node_modules/**",
      "firebase-debug.log",
      "firebase-debug.*.log",
      ".firebaserc",
      "firebase.json",
      ".env",
      ".env.*",
      "index.html",
      "sw.js",
      "manifest.webmanifest",
      "assets/**",
      "web-comercial/**",
      "FIREBASE-MIGRATION.md",
      "firebase.env.example",
      "env.example",
      "README.md",
      "vercel.json"
    ]
  },
  "hosting": {
    "target": "app",
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "**/.*",
      "**/node_modules/**",
      "api/**",
      "lib/**",
      "functions-entry.js",
      "package.json",
      "package-lock.json",
      "vercel.json",
      "env.example",
      "README.md",
      "firebase-debug.log",
      "firebase-debug.*.log",
      "FIREBASE-MIGRATION.md",
      "firebase.env.example"
    ],
    "rewrites": [
      {
        "source": "/api/**",
        "function": {
          "functionId": "api",
          "region": "us-central1"
        }
      }
    ],
    "headers": [
      {
        "source": "/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/index.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/sw.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/(.*)",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "Permissions-Policy",
            "value": "camera=(), microphone=(), geolocation=()"
          }
        ]
      }
    ]
  }
}
