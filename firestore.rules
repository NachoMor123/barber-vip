rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }
    function isBarber(barberId) {
      return signedIn() && request.auth.uid == barberId;
    }
    // Los perfiles internos y los cambios se administran desde las API del servidor.
    match /userProfiles/{uid} {
      allow read, write: if false;
    }

    match /barbers/{barberId} {
      // El documento padre contiene configuración interna y solo lo lee el barbero.
      // Los clientes reciben un perfil público filtrado por la API del servidor.
      allow get: if isBarber(barberId);
      allow list, create, update, delete: if false;

      match /customers/{customerId} {
        allow get: if isBarber(barberId) || (signedIn() && request.auth.uid == customerId && resource.data.active == true);
        allow list: if isBarber(barberId);
        allow create, update, delete: if false;
      }

      // Tiny promotion revision marker. Customers can read only their linked barber's marker;
      // the actual promotion payload still comes from the server API.
      function isLinkedCustomer(barberIdForCheck) {
        return signedIn()
          && get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.role == 'customer'
          && get(/databases/$(database)/documents/userProfiles/$(request.auth.uid)).data.barberUid == barberIdForCheck;
      }
      match /publicMeta/{metaId} {
        allow get: if metaId == 'promotions' && (isBarber(barberId) || isLinkedCustomer(barberId));
        allow list, create, update, delete: if false;
      }

      match /cuts/{cutId} {
        allow read: if isBarber(barberId);
        allow write: if false;
      }

      match /redemptions/{redemptionId} {
        allow read, write: if false;
      }

      match /payments/{paymentId} {
        allow read, write: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
