rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isBarber(barberId) {
      return signedIn() && request.auth.uid == barberId;
    }

    // The server API owns profile and role mapping writes.
    match /userProfiles/{uid} {
      allow read, write: if false;
    }

    match /barbers/{barberId} {
      // The parent profile contains private professional data; owner only.
      allow get: if isBarber(barberId);
      allow list, create, update, delete: if false;

      match /customers/{customerId} {
        // Admin can view the barber's customer list; each customer can view only their own active card.
        allow get: if isBarber(barberId)
          || (signedIn() && request.auth.uid == customerId && resource.data.active == true);
        allow list: if isBarber(barberId);
        allow create, update, delete: if false;
      }

      match /publicMeta/{metaId} {
        // The promotion marker contains only an opaque revision ID and timestamp.
        // No get()/exists() lookups means no extra rule-document reads for each notification.
        allow get: if signedIn() && metaId in ['promotions', 'professional'];
        allow list, create, update, delete: if false;
      }

      // History is disabled: the app no longer reads or writes visit audit documents.
      match /cuts/{cutId} {
        allow read, write: if false;
      }

      match /redemptions/{redemptionId} {
        allow read, write: if false;
      }

      match /payments/{paymentId} {
        allow read, write: if false;
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
