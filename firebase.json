{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "target": "app",
    "public": ".",
    "ignore": [
      "firebase.json",
      ".firebaserc",
      "**/.*",
      "**/node_modules/**",
      "api/**",
      "lib/**",
      "functions/**",
      "worker/**",
      ".github/**",
      "package.json",
      "package-lock.json",
      "vercel.json",
      "env.example",
      "README.md",
      "SPARK-SETUP.md",
      "firestore.rules",
      "tests/**",
      "*.test.js"
    ],
    "headers": [
      {
        "source": "/",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
        ]
      },
      {
        "source": "/index.html",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
        ]
      },
      {
        "source": "/sw.js",
        "headers": [
          { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
        ]
      },
      {
        "source": "/(.*)",
        "headers": [
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
          { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()"
          }
        ]
      }
    ]
  }
}
